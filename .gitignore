# ---------------------------------------------------------------------------
# Secrets and machine-local configuration
# ---------------------------------------------------------------------------
# SEC requires real contact details in the User-Agent. Kept out of the repo so
# a public clone never carries a personal email address (see src/config.py).
.sec_user_agent
.env
.env.*
# ...but the template showing the expected format is tracked.
!.sec_user_agent.example

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
venv/
.venv/
env/
ENV/

# ---------------------------------------------------------------------------
# Pipeline data — all of it is regenerated by `python src/run_pipeline.py`
# ---------------------------------------------------------------------------
# Cached SEC API responses (~500KB per company; re-fetched with --refresh).
data/raw/*.json
data/processed/*
!data/**/.gitkeep

# SQLite database, rebuilt from data/raw on every run.
db/*.db
db/*.db-journal
db/*.sqlite*

# ---------------------------------------------------------------------------
# Generated output
# ---------------------------------------------------------------------------
# Everything under output/ is generated. Most of it is bulk data that would
# only add churn, so it is ignored -- but the finished deliverables are kept
# in the repo (negated below) so the work can be read on GitHub without
# cloning and running the pipeline first.
output/*
!output/.gitkeep

# Deliverables worth committing. Note that gitignore has no inline comments --
# a trailing "# ..." becomes part of the pattern and the rule silently stops
# matching, so every comment here is on its own line.
#
# The self-contained dashboard, openable straight from a clone:
!output/dashboard.html
# The Excel underwriting model:
!output/credit_underwriting_model.xlsx
# The headline result and the per-company summary:
!output/watchlist.csv
!output/metrics_summary.csv
# The generated credit memos, which render on GitHub:
!output/memos/
!output/memos/*.md
# The authored Power BI artefacts (not the data extracts):
!output/powerbi/
!output/powerbi/BUILD_GUIDE.md
!output/powerbi/measures.dax

# ...but not the bulk data extracts feeding them.
output/powerbi/*.csv
output/metrics_all_periods.csv
output/stress_test_results.csv
output/stress_matrix*.csv
output/trends.csv
output/watchlist_triggers.csv

# ---------------------------------------------------------------------------
# Editors and operating systems
# ---------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini
.idea/
.vscode/
.claude/
*.swp
*.swo
*~
.ipynb_checkpoints/

# Excel/Office lock files
~$*.xlsx
~$*.docx
